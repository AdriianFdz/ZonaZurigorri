# ==============================================
# DATABASE CONFIGURATION
# ==============================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=zona_zurigorri

# ==============================================
# JWT CONFIGURATION
# ==============================================
# IMPORTANTE: Cambia esto en producción por una clave segura
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRATION=3600

# ==============================================
# GOOGLE OAUTH CONFIGURATION
# ==============================================
# Obtén tus credenciales en: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:8000/api/auth/google/callback

# ==============================================
# DISCORD OAUTH CONFIGURATION
# ==============================================
# Obtén tus credenciales en: https://discord.com/developers/applications
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
DISCORD_CALLBACK_URL=http://localhost:8000/api/auth/discord/callback

# ==============================================
# FRONTEND CONFIGURATION
# ==============================================
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_AUTH_SERVICE_URL=http://localhost:8000/api/auth
NEXT_PUBLIC_MAIN_SERVICE_URL=http://localhost:8000/api/v1